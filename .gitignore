# ========================
# Merchant Bazaar .gitignore
# ========================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python

# Virtual environment — NEVER commit
backend/venv/
backend/.venv/
venv/
.venv/

# Environment variables — NEVER commit real credentials
.env
.env.*
*.env
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
frontend/.env.local
frontend/.env.production
!*.env.example
!*.env.local.example
!backend/.env.example
!frontend/.env.example

# Alembic — keep versions, ignore __pycache__
backend/alembic/versions/__pycache__/

# Node / Next.js
node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
