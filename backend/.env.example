# =================================================================
# Merchant Bazaar - Backend Environment Configuration Template
# Create a copy named '.env' and fill in your actual credentials.
# NEVER commit your actual '.env' file to version control.
# =================================================================

# Database Connection String (PostgreSQL / Neon / Supabase)
DATABASE_URL=postgresql://username:password@localhost:5432/merchant_bazaar_db

# Security & JWT Token Authentication
# Generate a secure 32+ character key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-jwt-key-here-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Super Admin Initial Credentials (Used to auto-seed or login as admin)
ADMIN_EMAIL=admin@merchantbazaar.com
ADMIN_PASSWORD=ChangeThisToASecureAdminPassword123!

# Cloudinary Storage Credentials (Used for Store Logos and Hero Banners)
# Sign up free at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Application Metadata & Cross-Origin Settings
APP_NAME=Merchant Bazaar
BASE_DOMAIN=merchantbazaar.com
FRONTEND_URL=http://localhost:3000
